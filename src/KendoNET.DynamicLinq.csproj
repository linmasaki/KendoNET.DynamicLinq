<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>KendoNET.DynamicLinq</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>KendoNET.DynamicLinq</PackageId>
    <Title>KendoNET.DynamicLinq</Title>
    <Authors>CoCo Lin</Authors>
    <Description>Implements server paging, filtering, sorting, grouping and aggregating for Kendo UI via Dynamic Linq, targeting .NET 10.</Description>
    <PackageReleaseNotes>
1. Target .NET 10 exclusively. Consumers on .NET Standard, .NET Framework, .NET Core 1.x-3.x, or .NET 5-9 should stay on the 3.x line.
2. Align the package version with the .NET version it targets.
3. Report invalid filters through DataSourceResult.Errors instead of throwing.

Full changelog: https://github.com/linmasaki/KendoNET.DynamicLinq/blob/master/CHANGELOG.md
    </PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/linmasaki/KendoNET.DynamicLinq</PackageProjectUrl>
    <RepositoryUrl>https://github.com/linmasaki/KendoNET.DynamicLinq</RepositoryUrl>
    <PackageIconUrl>https://raw.githubusercontent.com/linmasaki/CoCoPackageIcon/master/cocodotnet64.png</PackageIconUrl>
    <PackageIcon>Icon.png</PackageIcon>
    <PackageTags>net dotnet kendo kendo-ui linq dynamic-linq</PackageTags>
    <PackageVersion>10.0.0</PackageVersion>
    <Version>10.0.0</Version>
    <Copyright>Copyright © 2017-2026 CoCo Lin</Copyright>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Linq.Dynamic.Core" Version="1.7.3"/>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\LICENSE" Pack="true" PackagePath=""/>
    <None Include="..\Icon.png" Pack="true" PackagePath=""/>
  </ItemGroup>

</Project>
