<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard1.6;netstandard2.0;netstandard2.1</TargetFrameworks>
    <RootNamespace>KendoNET.DynamicLinq</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>KendoNET.DynamicLinq</PackageId>
    <Title>KendoNET.DynamicLinq</Title>
    <Authors>CoCo Lin</Authors>
    <Description>Implements server paging, filtering, sorting, grouping and aggregating for Kendo UI via Dynamic Linq, targeting both .NET Core and modern .NET apps.</Description>
    <PackageReleaseNotes>
1. Add `IgnoreCase` option to `Filter` for case-insensitive string filtering.
2. Document that this package was previously published as Kendo.DynamicLinqCore and was renamed due to a trademark concern.

Full changelog: https://github.com/linmasaki/KendoNET.DynamicLinq/blob/master/CHANGELOG.md
    </PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/linmasaki/KendoNET.DynamicLinq</PackageProjectUrl>
    <RepositoryUrl>https://github.com/linmasaki/KendoNET.DynamicLinq</RepositoryUrl>
    <PackageIconUrl>https://raw.githubusercontent.com/linmasaki/CoCoPackageIcon/master/cocodotnet64.png</PackageIconUrl>
    <PackageIcon>Icon.png</PackageIcon>
    <PackageTags>net netcore netstandard kendo kendo-ui linq</PackageTags>
    <PackageVersion>3.2.0</PackageVersion>
    <Version>3.2.0</Version>
    <Copyright>Copyright © 2017-2026 CoCo Lin</Copyright>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)'=='netstandard1.6'">
    <PackageReference Include="System.AppDomain" Version="2.0.11"/>
    <PackageReference Include="System.Runtime.Serialization.Primitives" Version="4.3.0"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0"/>
    <PackageReference Include="System.Linq.Dynamic.Core" Version="1.6.0"/>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\LICENSE" Pack="true" PackagePath=""/>
    <None Include="..\Icon.png" Pack="true" PackagePath=""/>
  </ItemGroup>

</Project>
